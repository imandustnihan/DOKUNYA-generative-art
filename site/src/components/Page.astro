---
import Shell from '../layouts/Shell.astro';
import instruments from '../data/instruments.json';
import { copy, modeNames, route, type Language, type PageName } from '../data/content';

interface Props { language: Language; page: PageName }
const { language, page } = Astro.props;
const tx = copy[language];
const base = import.meta.env.BASE_URL;
const studioHref = base + 'studio/?lang=' + language;
const modeIds = ['neon_flow', 'particle_galaxy', 'symmetry_lab', 'liquid_light', 'geometry_pulse'];
const families = [...new Set(instruments.map((item) => item.family))];
const modeDescription = (i: number) => tx.modeDescriptions[i];
const pageDetails: Record<PageName, [string, string]> = {
  home: [tx.heroTitle, tx.heroBody],
  discover: [tx.discoverTitle, tx.discoverLead],
  guide: [tx.guideTitle, tx.guideLead],
  about: [tx.aboutTitle, tx.aboutLead],
  privacy: [tx.privacyTitle, tx.privacyLead],
};
const [heading, description] = pageDetails[page];
---
<Shell language={language} page={page} title={heading} description={description}>
  <main id="main">
    {page === 'home' && (
      <>
        <section class="hero wrap">
          <div class="hero-copy">
            <div class="eyebrow"><span class="signal"></span>{tx.eyebrow}</div>
            <h1>{tx.heroTitle}</h1>
            <p class="lead">{tx.heroBody}</p>
            <div class="hero-buttons">
              <a class="button button-primary" href={studioHref}>{tx.start}<span aria-hidden="true">↗</span></a>
              <a class="button button-quiet" href={route(language, 'discover', base)}>{tx.explore}<span aria-hidden="true">→</span></a>
            </div>
            <p class="hero-footnote"><span class="tiny-check" aria-hidden="true">✓</span>{tx.privacyPill}</p>
          </div>
          <div class="hero-visual" aria-label={tx.visualLabel}>
            <div class="ambient ambient-a"></div><div class="ambient ambient-b"></div>

            <div class="visual-frame">
              <img src={base + 'media/studio-preview.png'} alt={tx.visualLabel} width="1440" height="900" fetchpriority="high" decoding="async" />
            </div>

          </div>
        </section>
        <div class="capability-strip" aria-label="DOKUNYA">
          <div class="wrap strip-inner">{tx.strip.map((text) => <span>{text}</span>)}</div>
        </div>
        <section class="section wrap" id="engines">
          <div class="section-heading">
            <div><div class="eyebrow">{tx.sectionLabel}</div><h2>{tx.sectionTitle}</h2></div>
            <p>{tx.sectionBody}</p>
          </div>
          <div class="engine-grid">
            {modeNames.map((mode, i) => (
              <a class={'engine-card engine-' + i} href={studioHref + '&mode=' + modeIds[i]} aria-label={mode}>
                <div class="engine-illustration" aria-hidden="true"><span class="ring ring-1"></span><span class="ring ring-2"></span><span class="ring ring-3"></span><span class="engine-core"></span></div>
                <span class="engine-number">0{i + 1} / 05</span>
                <div class="engine-content"><h3>{mode}</h3><p>{modeDescription(i)}</p></div>
                <span class="engine-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
        <section class="section wrap workflow">
          <div class="section-heading"><div><h2>{tx.workflowTitle}</h2></div></div>
          <div class="workflow-grid">
            {tx.workflowSteps.map((item) => (
              <div class="workflow-step"><span>{item[0]}</span><p>{item[1]}</p></div>
            ))}
          </div>
          <div class="live-box">
            <div><h2>{tx.previewTitle}</h2><p>{tx.previewHelp}</p></div>
            <button class="button button-primary" type="button" data-preview-open>{tx.preview}<span aria-hidden="true">↗</span></button>
          </div>
          <div class="live-preview" id="live-preview" hidden>
            <div class="preview-bar"><strong>DOKUNYA STUDIO</strong><button type="button" data-preview-close>{tx.close} ×</button></div>
            <iframe title={tx.previewTitle} loading="lazy" data-src={studioHref} allow="fullscreen" allowfullscreen></iframe>
          </div>
        </section>
        <section class="closing wrap"><h2>{tx.privacyPill}</h2><p>{tx.privacyNote}</p><a href={route(language, 'privacy', base)}>{tx.nav.privacy}<span aria-hidden="true"> ↗</span></a></section>
      </>
    )}
    {page === 'discover' && (
      <section class="page-section wrap">
        <div class="page-intro"><h1>{tx.discoverTitle}</h1><p class="lead">{tx.discoverLead}</p></div>
        <section class="catalog" aria-labelledby="catalog-title">
          <div class="catalog-head">
            <h2 id="catalog-title">{tx.catalogTitle}</h2>
            <label>{tx.catalogSearch}<input type="search" data-catalog-search autocomplete="off" /></label>
          </div>
          <div class="catalog-families">
            {families.map((family) => (
              <details class="catalog-family">
                <summary>{family}</summary>
                <ul>{instruments.filter((item) => item.family === family).map((item) =>
                  <li><a href={studioHref + '&instrument=' + item.id} data-instrument={item.name}>{item.name}<span aria-hidden="true">↗</span></a></li>
                )}</ul>
              </details>
            ))}
          </div>
          <p role="status" data-catalog-empty hidden>{tx.noMatches}</p>
        </section>
        <div class="discovery-grid">
          {modeNames.map((mode, i) => (
            <article class={'discovery-item engine-' + i}>
              <div class="discovery-art" aria-hidden="true"><span class="ring ring-1"></span><span class="ring ring-2"></span><span class="ring ring-3"></span><span class="engine-core"></span></div>
              <div class="discovery-details"><span class="engine-number">ENGINE 0{i + 1}</span><h2>{mode}</h2><p>{modeDescription(i)}</p><a class="inline-link" href={studioHref + '&mode=' + modeIds[i]}>{tx.start}<span aria-hidden="true">↗</span></a></div>
            </article>
          ))}
        </div>
      </section>
    )}
    {page === 'guide' && (
      <section class="page-section wrap">
        <div class="page-intro"><h1>{tx.guideTitle}</h1><p class="lead">{tx.guideLead}</p></div>
        <div class="guide-grid">{tx.guideItems.map((item, i) => <article class="info-panel"><span class="info-index">0{i + 1}</span><h2>{item[0]}</h2><p>{item[1]}</p></article>)}</div>
        <div class="page-action"><a class="button button-primary" href={studioHref}>{tx.start} ↗</a></div>
      </section>
    )}
    {page === 'about' && (
      <section class="page-section wrap narrow">
        <div class="page-intro"><h1>{tx.aboutTitle}</h1><p class="lead">{tx.aboutLead}</p></div>
        <div class="editorial"><p>{tx.aboutBody}</p><p>{tx.aboutFoot}</p></div>
        <div class="page-action"><a class="button button-primary" href={studioHref}>{tx.start} ↗</a></div>
      </section>
    )}
    {page === 'privacy' && (
      <section class="page-section wrap">
        <div class="page-intro"><h1>{tx.privacyTitle}</h1><p class="lead">{tx.privacyLead}</p></div>
        <div class="guide-grid">{tx.privacyItems.map((item, i) => <article class="info-panel"><span class="info-index">0{i + 1}</span><h2>{item[0]}</h2><p>{item[1]}</p></article>)}</div>
        <p class="endnote">{tx.privacyNote}</p>
      </section>
    )}
  </main>
  <script>
    const search = document.querySelector<HTMLInputElement>('[data-catalog-search]');
    const empty = document.querySelector<HTMLElement>('[data-catalog-empty]');
    const families = Array.from(document.querySelectorAll<HTMLDetailsElement>('.catalog-family'));
    const expanded = new Set<HTMLDetailsElement>();
    let filtering = false;
    search?.addEventListener('input', () => {
      const query = search.value.trim().toLowerCase();
      if (query && !filtering) {
        expanded.clear();
        families.filter((family) => family.open).forEach((family) => expanded.add(family));
      }
      filtering = Boolean(query);
      let count = 0;
      for (const family of families) {
        const familyName = family.querySelector('summary')!.textContent.toLowerCase();
        let matches = 0;
        for (const item of family.querySelectorAll('li')) {
          item.hidden = !familyName.includes(query) && !item.textContent.toLowerCase().includes(query);
          if (!item.hidden) matches++;
        }
        count += matches;
        family.hidden = matches === 0;
        family.open = filtering ? matches > 0 : expanded.has(family);
      }
      if (empty) empty.hidden = count > 0;
    });
  </script>
  {page === 'home' && (
    <script>
      const open = document.querySelector<HTMLButtonElement>('[data-preview-open]');
      const close = document.querySelector<HTMLButtonElement>('[data-preview-close]');
      const frame = document.querySelector<HTMLIFrameElement>('#live-preview iframe');
      const panel = document.querySelector<HTMLElement>('#live-preview');
      open?.addEventListener('click', () => {
        if (!panel || !frame) return;
        panel.hidden = false;
        if (!frame.src) frame.src = frame.dataset.src || '';
        close?.focus();
        panel.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
      });
      close?.addEventListener('click', () => {
        if (panel) panel.hidden = true;
        // Keep the running workspace and its pending draft when the preview closes.
        open?.focus();
      });
    </script>
  )}
</Shell>
